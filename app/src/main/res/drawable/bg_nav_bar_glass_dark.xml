<?xml version="1.0" encoding="utf-8"?>
<!--
    深色版玻璃底栏（2026-10-17）。
    ★ 为什么不放 values-night/：智码通的主题由 Cyanea 管理，
      可能与系统 uiMode 不一致（系统深色 + 应用浅色白底），
      走资源目录切换会误用深色值，白底上叠加成灰块。
      改为由 HomeActivity 按 Cyanea 实际背景亮度显式选择。
    色值与「传信」values-night/colors.xml 完全一致，此处内联避免再受 night 影响。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 主底：纵向渐变（#8A2F333B → #661A1D22） -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#8A2F333B"
                android:endColor="#661A1D22"
                android:type="linear" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <!-- 顶部高光线（#33FFFFFF） -->
    <item android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:endColor="#00000000"
                android:type="linear" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <!-- 描边（#2EFFFFFF） -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
            <solid android:color="#00000000" />
            <corners android:radius="27dp" />
        </shape>
    </item>
</layer-list>
