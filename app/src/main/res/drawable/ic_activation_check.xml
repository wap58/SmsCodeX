<?xml version="1.0" encoding="utf-8"?>
<!--
    激活卡右侧的勾号圆环（2026-10-18）：
    圆环只画 3/4 圈（留缺口在左上），中间一个勾。
    按 24dp viewport 绘制，渲染尺寸由布局决定（会被卡片裁掉右下部分，制造溢出感）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- 圆环：stroke 4，起点约在 10 点钟方向，顺时针画 270° -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M24,4 A20,20 0 1,1 5.9,14"/>

    <!-- 勾 -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M15,24.5 L21.5,31 L34,17.5"/>
</vector>
