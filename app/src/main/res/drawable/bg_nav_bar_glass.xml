<?xml version="1.0" encoding="utf-8"?>
<!--
    毛玻璃底栏（2026-10-17，用户二次调整）：只让下方内容"隐约可见"。
    上一版用传信原值 #80FFFFFF（50% 白）→ 太透，底下的文字几乎清晰可读。
    本版提高不透明度到 88%~80%，下方内容透出后呈浅灰雾状，仅隐约可辨。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 主底：纵向渐变（上亮下暗，模拟受光） -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#E0FFFFFF"
                android:endColor="#CCFFFFFF"
                android:type="linear" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <!-- 顶部高光线 -->
    <item android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#66FFFFFF"
                android:endColor="#00000000"
                android:type="linear" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <!-- 描边 -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#80FFFFFF" />
            <solid android:color="#00000000" />
            <corners android:radius="27dp" />
        </shape>
    </item>
</layer-list>
