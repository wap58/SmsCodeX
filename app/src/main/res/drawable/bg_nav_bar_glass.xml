<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃：半透明渐变 + 高光描边，模拟玻璃光泽（逐行照搬「传信」bg_nav_bar_glass.xml） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 主底：纵向渐变（上亮下暗，模拟受光） -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/nav_glass_top"
                android:endColor="@color/nav_glass_bottom"
                android:type="linear" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <!-- 顶部高光线 -->
    <item android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/nav_glass_highlight"
                android:endColor="#00000000"
                android:type="linear" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <!-- 描边 -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/nav_stroke_glass" />
            <solid android:color="#00000000" />
            <corners android:radius="27dp" />
        </shape>
    </item>
</layer-list>
