<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.tianma.xsmscode.ui.home.HomeActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            layout="@layout/toolbar"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!--
        内容区：不预留底部内边距 —— 内容会流到悬浮胶囊下方，
        这样才能真正"透过"半透明胶囊看到后面的列表（用户 2026-10-17 明确要求）。
        列表底部由 CodeRecordFragment 用 clipToPadding=false + paddingBottom 留白，
        保证最后一条能滚出来，不被胶囊永远压住。
    -->
    <FrameLayout
        android:id="@+id/home_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/app_bar_layout"/>

    <!--
        ============ 底部导航（悬浮胶囊，对齐传信）============
        ★ 背景/高亮/图标色全部由 HomeActivity#applyNavTheme 运行时按 Cyanea 主题染色：
          本项目通过主题属性取色会回退失败（2026-09-15 实测），故不在 xml 里引 ?attr。
    -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="96dp"
        android:layout_marginEnd="96dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_nav_bar_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/nav_records"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item_selected"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_records_icon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@string/tab_records"
                android:src="@drawable/ic_records"/>

            <TextView
                android:id="@+id/nav_records_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_records"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_settings_icon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="@string/tab_settings"
                android:src="@drawable/ic_settings"/>

            <TextView
                android:id="@+id/nav_settings_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_settings"
                android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
