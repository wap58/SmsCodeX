<?xml version="1.0" encoding="utf-8"?>
<!--
    通道参数弹窗里的单个字段（2026-10-18 重做）：
    不再用裸下划线，改成圆角浅底输入框 —— 与整站的卡片风格一致。
    颜色全部由 ChannelSettingsDialog 运行时按 Cyanea 赋值，此处不写死。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="10dp">

    <TextView
        android:id="@+id/channel_field_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12.5sp" />

    <EditText
        android:id="@+id/channel_field_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_field_input"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:textSize="14sp" />
</LinearLayout>
