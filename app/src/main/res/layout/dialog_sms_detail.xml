<?xml version="1.0" encoding="utf-8"?>
<!--
    短信详情弹窗（2026-10-17 重做，对齐传信 dialog_sms_detail.xml）。

    结构：
      标题行（短信详情 · 关闭）
      ├ 卡片①：发件人 / 时间 / 转发状态（逐通道动态填充）
      └ 卡片②：短信正文
      底部操作：复制短信 / 转发信息 / 复制验证码

    配色由 SmsDetailDialog 运行时按 Cyanea 赋值（本项目主题属性取色会回退失败）。
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sms_detail_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/sms_detail_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/message_details"
                android:textSize="18sp"/>

            <TextView
                android:id="@+id/sms_detail_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="@string/close"
                android:textSize="15sp"/>
        </LinearLayout>

        <com.tianma.xsmscode.ui.forward.MaxHeightScrollView
            android:id="@+id/sms_detail_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbarStyle="outsideOverlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="2dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp">

                <!-- 卡片①：元信息 + 转发状态 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/sms_detail_meta_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/sms_detail_label_sender"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sms_detail_sender"
                                android:textSize="13sp"/>

                            <TextView
                                android:id="@+id/sms_detail_sender"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:singleLine="true"
                                android:ellipsize="middle"
                                android:textSize="13sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/sms_detail_label_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sms_detail_time"
                                android:textSize="13sp"/>

                            <TextView
                                android:id="@+id/sms_detail_time"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:textSize="13sp"/>
                        </LinearLayout>

                        <!-- ★ 转发状态：单独成块（用户 2026-10-17 要求），放在短信内容上方 -->
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 卡片②：短信正文 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/sms_detail_body_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/sms_detail_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:padding="14dp"
                        android:textIsSelectable="true"
                        android:textSize="14sp"/>
                </com.google.android.material.card.MaterialCardView>

                <!-- 转发状态独立卡片（2026-10-18 用户要求：从元信息里拆出来，放在正文下方） -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/sms_detail_forward_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/sms_detail_label_forward"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sms_detail_forward_status"
                            android:textSize="12.5sp"/>

                        <LinearLayout
                            android:id="@+id/sms_detail_forward_box"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.tianma.xsmscode.ui.forward.MaxHeightScrollView>

        <!-- 底部操作区 -->
        <View
            android:id="@+id/sms_detail_action_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>

        <!-- 2026-10-17：只保留「转发信息」，右对齐贴底（复制短信/复制验证码已移除） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/sms_detail_action_forward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="44dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/forward_to_wecom"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
