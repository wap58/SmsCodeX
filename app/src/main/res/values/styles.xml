<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppNoActionBarTheme" parent="Theme.Cyanea.Light.NoActionBar">
        <item name="preferenceIconColor">?android:attr/textColorPrimary</item>
        <item name="myMenuIconColor">?attr/menuIconColor</item>
        <item name="preferenceTheme">@style/MyPreferenceStyle</item>
    </style>

    <style name="AppActionBarTheme" parent="Theme.Cyanea.Light">
        <item name="preferenceIconColor">?android:attr/textColorPrimary</item>
        <item name="myMenuIconColor">?attr/menuIconColor</item>
        <item name="preferenceTheme">@style/MyPreferenceStyle</item>
    </style>

    <!--
        通道参数弹窗主题（2026-09-19）：
        1. 必须继承 Theme.Cyanea.*，否则 Cyanea 动态配色失效（弹窗会是 Material 默认青色）；
        2. 必须带 preferenceTheme，否则 PreferenceFragmentCompat 抛
           IllegalStateException: Must specify preferenceTheme in theme；
        3. windowIsFloating 让它成为浮层弹窗（而非整页 Activity）。
    -->
    <style name="Theme.XsmsCode.ChannelDialog" parent="AppNoActionBarTheme">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- 通道参数弹窗内的字段文字（2026-09-19）
         颜色由 ChannelSettingsDialog 在运行时按 Cyanea 配置显式设置：
         Cyanea 主题下解析 ?attr/textColorPrimary 会回退失败（项目 2026-09-15 已实测），
         所以这里只给占位值，实际颜色以代码赋值为准。 -->
    <style name="ChannelDialog.FieldTitle">
        <item name="android:textColor">#FF000000</item>
    </style>

    <style name="ChannelDialog.FieldInput">
        <item name="android:textColor">#FF000000</item>
        <item name="android:textColorHint">#66000000</item>
    </style>

    <style name="MyPreferenceStyle" parent="@style/PreferenceThemeOverlay.v14.Material">
        <item name="preferenceCategoryStyle">@style/MyPreferenceCategoryStyle</item>
    </style>

    <style name="MyPreferenceCategoryStyle" parent="@style/Preference.Category.Material">
        <item name="android:layout" tools:ignore="PrivateResource">@layout/preference_category</item>
    </style>

</resources>