<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        libxposed:service（2026-09-20）：
        该库 Maven 版要求 compileSdk 37（本项目 34），故改为本地 jar
        （app/libs/libxposed-service-102.0.0.jar）并在此声明其 Provider。
        库内仅使用 ContentProvider/Context/IBinder/Log 等基础 API，
        与 minSdk 23 兼容。
    -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name="com.tianma.xsmscode.ui.app.SmsCodeApplication"
        android:allowBackup="true"
        android:fullBackupContent="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:description="@string/xposed_description"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppNoActionBarTheme"
        tools:ignore="GoogleAppIndexingWarning,UnusedAttribute">

        <!-- xposed module configuration -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />

        <activity
            android:name="com.tianma.xsmscode.ui.home.HomeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".HomeActivityAlias"
            android:enabled="true"
            android:exported="true"
            android:targetActivity="com.tianma.xsmscode.ui.home.HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity
            android:name="com.tianma.xsmscode.ui.rule.CodeRulesActivity"
            android:exported="true"
            android:label="@string/import_rules">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern="/.*\\.scebak"
                    android:scheme="file" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="*"
                    android:mimeType="*/*"
                    android:pathPattern="/.*\\.scebak"
                    android:scheme="content" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:mimeType="application/octet-stream"
                    android:scheme="content" />
                <data
                    android:mimeType="application/json"
                    android:scheme="content" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.tianma.xsmscode.ui.record.CodeRecordActivity"
            android:label="@string/smscode_records" />

        <activity
            android:name="com.tianma.xsmscode.ui.block.AppBlockActivity"
            android:label="@string/app_block_settings" />

        <activity
            android:name="com.tianma.xsmscode.ui.forward.ChannelSettingsActivity"
            android:label="@string/forward_channel_settings" />

        <activity
            android:name="com.jaredrummler.cyanea.prefs.CyaneaThemePickerActivity"
            android:label="@string/label_theme_picker"
            android:theme="@style/AppActionBarTheme"
            tools:replace="android:theme" />

        <activity
            android:name="com.jaredrummler.cyanea.prefs.CyaneaSettingsActivity"
            android:label="@string/pref_theme_title"
            android:theme="@style/AppActionBarTheme"
            tools:replace="android:theme" />

        <provider
            android:name="com.tianma.xsmscode.data.db.DBProvider"
            android:authorities="${applicationId}.db.provider"
            android:exported="true" />

        <!--
            libxposed service 的 Provider（2026-09-20）：
            框架通过该 Provider 向模块 app 下发 XposedService，
            用于激活状态检测。原由 io.github.libxposed:service AAR 自动合并，
            因该库要求 compileSdk 37（本项目 34），改为手动打包其 jar
            （app/libs/libxposed-service-102.0.0.jar）并在此显式声明。
            authority 必须为 <applicationId>.XposedService（库内约定）。
        -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/files" />
        </provider>
        <service
            android:name="com.tianma.xsmscode.feature.forward.ForwardKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>

        <receiver
            android:name="com.tianma.xsmscode.feature.forward.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>